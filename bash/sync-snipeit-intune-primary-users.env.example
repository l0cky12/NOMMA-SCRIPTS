# Microsoft Entra application credentials (client-credentials flow)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-secret-from-secure-storage

# Source group. This script reads transitive user membership.
ENTRA_GROUP_ID=627b0785-7658-4f80-a3ff-c362a723cd4a

# Snipe-IT
SNIPEIT_URL=https://10.1.2.81
SNIPEIT_API_TOKEN=replace-with-snipe-it-api-token

# Preferred for an internal CA or self-signed certificate:
# SNIPEIT_CA_BUNDLE=/etc/nomma/nomma-internal-ca.pem

# Temporary testing only. Disables Snipe-IT TLS certificate verification.
SNIPEIT_INSECURE=false

# Optional HTTP retry tuning
HTTP_MAX_RETRIES=4
HTTP_RETRY_DELAY=2
