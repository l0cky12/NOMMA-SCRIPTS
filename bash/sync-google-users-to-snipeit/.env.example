# Copy to .env, replace placeholders, then chmod 600 .env.
# Google Workspace
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/nomma/google-directory-reader.json
GOOGLE_DELEGATED_ADMIN=admin@nomma.net
GOOGLE_CUSTOMER_ID=my_customer

# OU to sync (all sub-OUs included)
GOOGLE_OU=/Cadets
GOOGLE_DOMAIN=nomma.net

# Snipe-IT
SNIPEIT_URL=https://inv.nomma.tech
SNIPEIT_API_TOKEN=replace-with-snipeit-api-token
SNIPEIT_VERIFY_TLS=true
# SNIPEIT_CA_BUNDLE=/path/to/custom-ca.crt

# Grade to department mapping file
GRADE_DEPT_MAPPING=config/grade-department-mapping.json

# Logging
LOG_LEVEL=1
# LOG_FILE=/var/log/google-snipeit-user-sync.log