# Copy to .env, replace placeholders, then chmod 600 .env.
SNIPEIT_URL=https://inv.nomma.tech
SNIPEIT_API_TOKEN=replace-with-snipeit-api-token
GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/google-service-account.json
GOOGLE_DELEGATED_ADMIN=admin@example.org
GOOGLE_CUSTOMER_ID=my_customer
MODEL_MAPPING_FILE=config/model-mapping.json
LOG_LEVEL=INFO
LOG_FILE=logs/sync.log
LOCK_FILE=logs/sync.lock
SNIPEIT_CATEGORY_NAME=Chromebook
# Preserve this exact configured spelling until verified in Snipe-IT.
SNIPEIT_STATUS_NAME=Ready to Depoly
SNIPEIT_COMPANY_NAME=New Orleans Military & Maritime Academy
SNIPEIT_VERIFY_TLS=true
