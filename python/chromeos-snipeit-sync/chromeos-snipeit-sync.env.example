# chromeos-snipeit-sync environment configuration
#
# Copy to a file OUTSIDE the repo (e.g. /etc/nomma/chromeos-snipeit-sync.env),
# fill in real values, then: chmod 600 <file>
# Load it before running:  set -a; . /etc/nomma/chromeos-snipeit-sync.env; set +a
#
# NEVER commit a filled-in copy — *.env files in this directory are gitignored,
# but files outside the repo are safer still.

# ── Google Admin (service account with domain-wide delegation) ─────────
# Path to the service-account JSON key (chmod 600, keep outside the repo)
GOOGLE_SA_KEY_FILE=/etc/nomma/chromeos-sync-sa.json
# Workspace admin the service account impersonates (needs ChromeOS read access)
GOOGLE_ADMIN_SUBJECT=admin@example.org
# Usually the literal string my_customer
#GOOGLE_CUSTOMER_ID=my_customer

# ── Snipe-IT ────────────────────────────────────────────────────────────
SNIPEIT_URL=https://snipeit.example.org
SNIPEIT_API_TOKEN=paste-token-here
# Status label for NEW assets (must already exist in Snipe-IT)
#SNIPEIT_STATUS_LABEL=Ready to Deploy
# Set false only for self-signed HTTPS certificates
#SNIPEIT_VERIFY_TLS=true

# ── Problem email (required for --non-interactive cron runs) ───────────
SMTP_HOST=smtp.example.org
#SMTP_PORT=587
SMTP_USERNAME=alerts@example.org
SMTP_PASSWORD=paste-password-here
SMTP_FROM=alerts@example.org
# Comma-separated for multiple recipients
SMTP_TO=you@example.org

# ── Paths (defaults live next to the script) ───────────────────────────
#SYNC_MODEL_MAP_FILE=/opt/nomma/model-map.json
#SYNC_REPORT_DIR=/var/log/chromeos-snipeit-sync/reports
