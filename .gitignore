# NOMMA PKI — Git Ignore Rules

# ── Ansible ──────────────────────────────────────────────────────────
# NEVER commit unencrypted vault files
**/vault.yml
!**/vault.example.yml

# Ansible retry files
*.retry

# Ansible galaxy roles
**/roles/external/

# ── PKI Secrets ──────────────────────────────────────────────────────
# Private keys — NEVER commit these
*.key.pem
*.key.pem.*
**/private/*.pem

# Certificate Signing Requests (may contain sensitive info)
**/csr/*.pem
**/requests/*.pem

# CA database (contains operational state, not secrets but not portable)
**/index.txt
**/index.txt.attr
**/index.txt.old
**/index.txt.attr.old
**/serial
**/serial.old
**/crlnumber
**/crlnumber.old

# ── OS / Editor ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.bak

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── Vault password file ──────────────────────────────────────────────
vault-password.txt
.vault-password.txt

# ── ChromeOS → Snipe-IT sync ─────────────────────────────────────────
# Filled-in env files and service-account keys — NEVER commit these
python/chromeos-snipeit-sync/*.env
!python/chromeos-snipeit-sync/*.env.example
python/chromeos-snipeit-sync/service-account*.json
# Runtime artifacts
python/chromeos-snipeit-sync/reports/
python/chromeos-snipeit-sync/model-map.json
python/chromeos-snipeit-sync/venv/

# ── Snipe-IT → Intune primary-user sync ──────────────────────────────
# Filled-in environment files and generated audit reports
bash/sync-snipeit-intune-primary-users.env
bash/reports/

# ── Google Workspace → Snipe-IT user sync ───────────────────────────
# Filled-in env files — NEVER commit these
bash/sync-google-users-to-snipeit/.env
!bash/sync-google-users-to-snipeit/.env.example
bash/sync-google-users-to-snipeit/config/grade-department-mapping.json
!bash/sync-google-users-to-snipeit/config/grade-department-mapping.example.json